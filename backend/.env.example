# Copy to backend/.env for local use. In production set these in your host's dashboard instead. NEVER commit the real file.
# Providers with no key are skipped automatically. Need at least one.
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

GEMINI_MODEL=gemini-3.6-flash
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# Model IDs are NOT verified against live provider docs: check them if a provider shows red in the status chips.
MAX_OUTPUT_TOKENS=8000

# AI review (advisory second opinion). Uses your OPENROUTER_API_KEY.
REVIEW_MODEL=nvidia/nemotron-3.5-super-vl:free
# Paid fail-safe, used ONLY after every other provider fails. Needs OpenRouter credit. Leave empty to disable.
# FAILSAFE_MODEL=

# Abuse protection (AI endpoints only). A whole school can share ONE public IP: raise PER_MIN if teachers get blocked.
# RATE_LIMIT_PER_MIN=10
# RATE_LIMIT_GLOBAL_PER_MIN=60

# Local dev only. Exposes /docs, raw provider errors and quota-burning probe endpoints. NEVER set this in production.
# DEBUG_ENDPOINTS=1
