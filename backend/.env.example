GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-120b
# Model IDs above are NOT verified against live provider docs: check them.
MAX_OUTPUT_TOKENS=8000
# Dev only: enables /api/debug/probe-all and /api/debug/provider/<name>. Remove before deploying.
# DEBUG_ENDPOINTS=1
# Cloudflare Workers AI (free, email signup, no card): needs the API token AND your account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# AI review (advisory second opinion). Uses your OPENROUTER_API_KEY.
REVIEW_MODEL=apodex/apodex-1.1-mini:free
# Paid fail-safe, used ONLY after every other provider fails. Needs OpenRouter credit. Leave empty to disable.
# FAILSAFE_MODEL=
